<?php

/**
 * @file
 * EduDemo University demo: landing/front page, Academics, and About pages,
 * plus the global "university" CSS layer over Olivero.
 *
 * Node content is not configuration, so it cannot travel through
 * `drush config:export`. This module ships the demo pages as code and creates
 * (or refreshes) them via edudemo_demo_create_pages().
 *
 * On a site installed from exported configuration, this module can be enabled
 * during config import — before the `page` node type's `body` field has been
 * attached — so a page may first be created with an empty body. Running
 * edudemo_demo_create_pages() again (see the module README) repairs it once the
 * field exists. The function is idempotent and safe to run any number of times.
 */

use Drupal\node\Entity\Node;

/**
 * Implements hook_page_attachments().
 *
 * Loads the EduDemo University styling on the front end (Olivero) only, so the
 * admin theme (Claro) is left untouched.
 */
function edudemo_demo_page_attachments(array &$attachments) {
  if (\Drupal::theme()->getActiveTheme()->getName() === 'olivero') {
    $attachments['#attached']['library'][] = 'edudemo_demo/university';
  }
}

/**
 * Creates the demo pages, or syncs existing ones to the definitions below.
 *
 * Pages are matched by their path alias (a stable key), so titles and bodies
 * can be updated on redeploy. Safe to run repeatedly.
 */
function edudemo_demo_create_pages() {
  // Make sure freshly-imported page/body field definitions are visible.
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  $alias_manager = \Drupal::service('path_alias.manager');

  // The Standard profile adds its own "Home" link to the main menu; this
  // module already provides one (edudemo_demo.home), so remove the duplicate.
  $menu_links = \Drupal::entityTypeManager()->getStorage('menu_link_content')
    ->loadByProperties(['menu_name' => 'main', 'title' => 'Home']);
  foreach ($menu_links as $link) {
    $link->delete();
  }

  foreach (_edudemo_demo_pages() as $page) {
    $node = NULL;
    $path = $alias_manager->getPathByAlias($page['alias']);
    if (preg_match('#^/node/(\d+)$#', $path, $m)) {
      $node = Node::load($m[1]);
    }

    if ($node) {
      $changed = FALSE;
      if ($node->getTitle() !== $page['title']) {
        $node->setTitle($page['title']);
        $changed = TRUE;
      }
      // Keep the body in sync with the definition (also repairs empty bodies).
      if ($node->hasField('body') && (string) $node->get('body')->value !== $page['body']) {
        $node->set('body', ['value' => $page['body'], 'format' => 'full_html']);
        $changed = TRUE;
      }
      if ($changed) {
        $node->save();
      }
      continue;
    }

    Node::create([
      'type' => 'page',
      'title' => $page['title'],
      'status' => 1,
      'uid' => 1,
      'body' => [
        'value' => $page['body'],
        'format' => 'full_html',
      ],
      'path' => [
        'alias' => $page['alias'],
        'pathauto' => 0,
      ],
    ])->save();
  }
}

/**
