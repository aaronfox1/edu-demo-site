<?php

/**
 * @file
 * Install/uninstall hooks for the EduDemo Demo Content module.
 */

/**
 * Implements hook_install().
 *
 * Creates the landing (front) page, Courses page, and About page. See
 * edudemo_demo_create_pages() in edudemo_demo.module for details and for the
 * repair behavior used when installing a site from configuration.
 */
function edudemo_demo_install() {
  edudemo_demo_create_pages();
}

/**
 * Implements hook_uninstall().
 *
 * Removes the demo pages created by this module.
 */
function edudemo_demo_uninstall() {
  $titles = array_column(_edudemo_demo_pages(), 'title');
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nodes = $storage->loadByProperties(['title' => $titles]);
  if ($nodes) {
    $storage->delete($nodes);
  }
}
